#!/usr/bin/env bash
set -euo pipefail

# Full SDK: CROSSBRIDGE_IMAGE=ghcr.io/33tu/crossbridge:15.0.0.3-full ./bin/crossbridge <command>
image="${CROSSBRIDGE_IMAGE:-ghcr.io/33tu/crossbridge:15.0.0.3-light}"

docker_args=(--rm --user "$(id -u):$(id -g)" -v "${PWD}:/work" -w /work -e FLEX=/opt/flex)
if [[ -t 0 && -t 1 ]]; then
    docker_args+=(-it)
fi

if [[ $# -eq 0 ]]; then
    set -- bash
fi

exec docker run "${docker_args[@]}" "$image" "$@"
